---
import { Icon } from "astro-icon/components";
import { Image } from 'astro:assets';
import { ACHIEVEMENTS, getAllAchievementIds, getIconMetadata, type AchievementId } from '@scripts/steam-achievement';

const achievementIds = getAllAchievementIds();
const achievements = achievementIds.map(id => ACHIEVEMENTS[id]);
---

<div id="steam-overlay" transition:persist transition:persist-props
    class="fixed inset-0 z-[999999] bg-black/90 opacity-0 invisible transition-all duration-300 ease-in-out p-5"
    data-state="closed">
    <div id="steam-session" class="text-white absolute top-5 left-5">
        <div id="steam-time" class="text-2xl font-bold">3:57 AM</div>
        <div id="steam-date" class="text-sm">Tue. January 1, 2026</div>
        <div class="text-sm"><span id="steam-session-time"> 0 minutes </span> - this session</div>
    </div>

	<div id="steam-back" class="absolute top-5 right-5 flex items-center gap-4 text-white">
		<div class="flex flex-col text-right leading-tight">
			<div class="text-2xl font-bold"> Back to Site </div>
			<div class="text-sm"> (Shift+Tab) </div>
		</div>
		<div id="steam-close-btn" class="cursor-pointer aspect-square h-[56px] bg-neutral-800 rounded flex items-center justify-center">
			<Icon name="mdi:close" class="text-2xl"/>
		</div>
	</div>

	<!-- Achievements Panel -->
	<div id="achievement-panel" class="absolute max-w-screen" style="width: 450px;">
		<div class="bg-gradient-to-b from-[#1e2329] to-[#171a21] rounded shadow-2xl">
			<!-- Header -->
			<div class="relative bg-gradient-to-br from-[#23262e] to-[#151a21] px-4 py-3 flex flex-col border-b border-black ">
				<div id="panel-header" class="cursor-move flex flex-col w-[calc(100% + 2rem)] h-8 -mx-4 -mt-3 px-4 pt-3"></div>

				<!--
				<div id="achievement-close" class="absolute top-2 right-2 text-white cursor-pointer hover:text-red-400 transition-colors">
					<Icon name="mdi:close" />
				</div>
				-->
				<!-- Header -->
				<div class="flex flex-row justify-between items-right mb-2">
					<div class="text-white text-2xl font-semibold tracking-wide">Achievements</div>

				</div>
				<!-- Stats -->
				<div class="bg-[#272c34] p-2 text-white font-semibold">
					<div class="flex flex-row justify-between items-center">
						<div class="text-xs"><span id="steam-unlocked-count"> 0 </span> OF <span id="steam-total-count"> {achievements.length} </span> ACHIEVEMENTS EARNED</div>
						<div class="text-xs" id="steam-percentage">(0%)</div>
					</div>
					<div class="relative">
						<div class="rounded-full bg-neutral-700 h-2 mt-2"> </div>
						<div id="steam-progress-bar" class="absolute top-0 left-0 rounded-full bg-blue-400 h-2 transition-all duration-500" style="width: 0%"> </div>
					</div>
				</div>

				<div class="tabs-scroll-container overflow-x-auto mt-2">
					<div class="flex flex-row items-center justify-center text-xs text-white font-semibold space-x-2 min-w-max">
						<div class="cursor-pointer whitespace-nowrap flex-shrink-0 text-right p-2" data-achievement-tab="in-progress"> IN PROGRESS </div>
						<div class="cursor-pointer whitespace-nowrap flex-shrink-0 text-center p-2 bg-neutral-700 rounded-full px-4" data-achievement-tab="my"> MY ACHIEVEMENTS </div>
						<div class="cursor-pointer whitespace-nowrap flex-shrink-0 text-left p-2" data-achievement-tab="global"> GLOBAL ACHIEVEMENT </div>
					</div>
				</div>
			</div>


			<!-- Achievements List -->
			<div id="achievements-list" class="tabs-scroll-container overflow-y-auto py-2" style="max-height: 400px;">
				<!-- Achievement Items -->

				{achievements.map(achievement => (
					<div
						class="achievement-item flex gap-3 px-4 py-3 border-b border-black/30 hover:bg-white/[0.02] transition-colors opacity-50"
						data-achievement-id={achievement.id}
					>
						<div class="achievement-icon w-12 h-12 hover:scale-150 transition-transform select-none rounded flex-shrink-0 flex items-center justify-center text-2xl shadow-lg bg-gradient-to-br from-[#3d3d3d] to-[#2d2d2d]">
							{achievement.isSecret ? (
								<Icon name="mdi:lock-outline" class="text-white"/>
							) : (
								<Image src={getIconMetadata(achievement.id as AchievementId)} width={48*2} format="avif" alt="Achievement Icon" class="w-12 h-12 object-contain opacity-30"/>
							)}
						</div>
						<div class="flex-1 min-w-0">
							<div class="flex justify-between items-start mb-1">
								<div class="text-[#c7d5e0] text-[13px] font-medium">
									{achievement.isSecret ? "???" : achievement.title}
								</div>
								<div class="text-[#66c0f4] text-[11px] whitespace-nowrap ml-2 achievement-unlock-date"></div>
							</div>
							<div class="text-[#8f98a0] text-[11px] leading-relaxed mb-0.5">
								{achievement.isSecret ? "Hidden achievement - keep exploring!" : achievement.description}
							</div>
						</div>
					</div>
				))}
			</div>

			<!-- Global Achievements List (populated client-side from /api/achievements/stats) -->
			<div id="global-achievements-list" class="hidden tabs-scroll-container overflow-y-auto py-2" style="max-height: 400px;"></div>

			<!-- Resize Handle -->
			<div class="absolute bottom-0 right-0 w-6 h-6">
				<div class="w-full h-full overflow-auto resize" inert/> {/* Hijacking the resize icon */ }
			</div>
			<div id="resize-handle" class="absolute bottom-0 right-0 w-6 h-6 cursor-nwse-resize -mr-1 -mb-1"/>
		</div>
	</div>
</div>

<style>
	/* Transition states */
	#steam-overlay[data-state="open"] {
		opacity: 1;
		visibility: visible;
	}

	/* Show unlocked achievement images */
	.achievement-item:not(.opacity-50) .achievement-icon img {
		opacity: 1 !important;
	}

	.tabs-scroll-container {
		scrollbar-width: thin;
		scrollbar-color: rgba(131, 131, 131, 0.5) rgba(0, 0, 0, 0.2);
	}
</style>