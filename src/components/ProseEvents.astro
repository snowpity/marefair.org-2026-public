<style>
    @reference "tailwindcss";
    /* I'm doing this because I need <a> in li to not be a box */
    :global(.prose li a) {
        @apply !inline !bg-transparent !text-blue-300 !p-0 !m-0 !rounded-none !underline !transition-colors;
    }
    :global(.prose li a:hover) {
