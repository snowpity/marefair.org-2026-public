---
import { Image, getImage } from 'astro:assets';

import ScrollBottom from '@assets/sponsors/BOT.png';
import ScrollCenter_RAW from '@assets/sponsors/MID.png';
import Scrolltop from '@assets/sponsors/TOP.png';

const scrollWidth = 1024;
const ScrollCenter = await getImage({ src:ScrollCenter_RAW, format:"avif", width: scrollWidth });


import woodRaw from "@assets/bg/wood.png";
const wood = await getImage({ src: woodRaw, format:"png", height:2048});
---


<div class={`relative z-10 transition-opacity`} style={`--img-width: ${scrollWidth}px`}>
    <div id="board" class="relative h-full overflow-hidden drop-shadow-xl/100">
        <div id="top" class="relative flex flex-wrap justify-center pointer-events-none select-none mt-32">
            <Image src={Scrolltop} alt="" format="avif" width={scrollWidth} class=`block mx-auto scrollMinWidth` style=``/>
        </div>
        {/* change height to Auto if using height affecting divs i.e. texts or relative images*/}
        <div id="cen" class="relative max-w-full mx-auto bg-top flex flex-wrap items-center justify-center h-auto pb-10 scrollWidth" style={`background-image: url(${ScrollCenter.src});`}>
            <div id="corkboard-container" class="lora-500 flex flex-col relative justify-center lg:w-[1000px] w-[720px] -mt-20 max-w-screen z-[1] p-10" style="grid-auto-flow: row dense;">
                <div class="lg:px-25 sm:px-5 px-0 text-black">
                    <slot/>
                </div>
            </div>
        </div>
        <div id="bot" class="relative flex flex-wrap justify-center pointer-events-none select-none z-[0] -mt-40 w-full ">
            <div class="relative w-fit h-fit">
                <Image src={ScrollBottom} alt="" format="avif" width={scrollWidth} class=`block mx-auto scrollMinWidth` style=``/>
            </div>
        </div>
    </div>
</div>
<style>
    @reference "tailwindcss";
    .scrollMinWidth {
        @apply sm:min-w-[var(--img-width)] min-w-[640px] sm:w-[var(--img-width)] w-[640px];
    }
    .scrollWidth {
        @apply sm:w-[var(--img-width)] w-[640px] sm:bg-size-[var(--img-width)_auto] bg-size-[640px_auto];
    }

    #navigation-toggle:checked ~ #coc-nav {
        @apply -right-full;
    }
    #navigation-toggle:checked ~ #navigation-toggle-button {
        @apply -rotate-90;
    }
    #navigation-toggle-mobile:checked ~ #coc-nav-mobile {
        @apply right-0;
    }
    #navigation-toggle-mobile:checked ~ #navigation-toggle-button-mobile {
        @apply rotate-0;
    }
</style>