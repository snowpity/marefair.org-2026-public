export function buildRoomMapping(roomList: typeof rooms): Record<string, string> {
    const mapping: Record<string, string> = {};

    roomList.forEach((r) => {
        mapping[r.room] = r.room;
        if (r.desc) {
            mapping[`${r.room} (${r.desc})`] = r.room;
        }
        r.alternates?.forEach((alt) => {
            mapping[alt] = r.room;
        });
    });

    return mapping;
}
