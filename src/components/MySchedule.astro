---
import { Icon } from 'astro-icon/components'
// MySchedule.astro
// Client-side drawer component - reads from localStorage via my-schedule-store.ts
---

{/* My Schedule Drawer */}
<div id="my-schedule-drawer" class="fixed inset-0 z-50 pointer-events-none">
    {/* Backdrop */}
    <div
        id="my-schedule-backdrop"
        class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 cursor-pointer"
    ></div>

    {/* Drawer Panel */}
    <div
        id="my-schedule-panel"
        class="absolute top-0 right-0 h-full w-full max-w-lg bg-gray-900 shadow-2xl shadow-black/50 transform translate-x-full transition-transform duration-300 flex flex-col"
    >
        {/* Header */}
        <div class="flex items-center justify-between p-4 border-b border-gray-700 bg-gray-800 shrink-0">
            <div class="flex items-center gap-3">
                <Icon name="mdi:calendar-star" class="text-white text-2xl"/>
                <h2 class="text-white font-bold text-xl reddit-sans">My Schedule</h2>
            </div>
            <div class="flex items-center gap-2">
                <button
                    id="share-my-schedule-btn"
                    class="text-xs text-amber-300 hover:text-amber-200 border border-amber-300/40 hover:border-amber-200 px-2 py-1 rounded transition-colors">
                    Share
                </button>
                <button
                    id="import-my-schedule-btn"
                    class="text-xs text-cyan-300 hover:text-cyan-200 border border-cyan-300/40 hover:border-cyan-200 px-2 py-1 rounded transition-colors">
                    Import
                </button>
                <button
                    id="clear-my-schedule-btn"
                    class="text-xs text-red-400 hover:text-red-300 border border-red-400/40 hover:border-red-300 px-2 py-1 rounded transition-colors mr-12">
                    Clear All
                </button>
            </div>
        </div>

        {/* Event Count */}
        <div class="px-4 py-2 bg-gray-800/50 border-b border-gray-700/50 text-sm text-gray-400 shrink-0 flex justify-between">
            <span id="my-schedule-count">0 events saved</span>
            <button
                id="close-my-schedule-btn"
                class="text-gray-400 hover:text-white transition-colors p-1 rounded hover:bg-gray-700 cursor-pointer"
                aria-label="Close My Schedule"
            >
                <Icon name="mdi:close" class="text-white text-xl"/>
            </button>
        </div>

        {/* Day Tabs */}
        <div class="flex border-b border-gray-700 shrink-0 bg-gray-800/30">
            {['All', 'Friday', 'Saturday', 'Sunday'].map((day) => (
                <button
                    class="my-schedule-day-tab flex-1 py-2 text-sm font-medium text-gray-400 hover:text-white transition-colors border-b-2 border-transparent"
                    data-day={day}
                >
                    {day}
                </button>
            ))}
        </div>

        {/* Events List */}
        <div id="my-schedule-list" class="flex-1 overflow-y-auto p-4 space-y-3"></div>

        {/* Empty State */}
        <div id="my-schedule-empty" class="flex-1 flex-col items-center justify-center text-center p-8 hidden">
            <Icon name="mdi:calendar-star" class="text-7xl text-gray-400"/>
            <p class="text-gray-400 font-medium text-lg">No events yet</p>
            <p class="text-gray-600 text-sm mt-2">Click "Add to My Schedule" on any panel to save it here.</p>
        </div>
    </div>
</div>

<script>
    import {
        getSavedRefs,
        saveSavedRefs,
        isIdSaved,
        removeSavedId,
        getSavedContextIds,
        replaceWithContextIds,
        buildLiveScheduleIndex,
        resolveSavedSchedule,
        makeEventId,
        type SavedEvent
    } from '@scripts/my-schedule-store';

    const SHARE_PARAM = 'schedule';
    let handledUrlImport = false;

    // -- Helpers -------------------------------------------------------------------

    function getRatingBorder(rating: string): string {
        if (rating.includes('Safe')) return 'border-green-400 bg-green-400/10';
        if (rating.includes('Suggestive')) return 'border-cyan-400 bg-cyan-400/10';
        if (rating.includes('Questionable')) return 'border-amber-400 bg-amber-400/10';
        if (rating.includes('Explicit')) return 'border-red-400 bg-red-400/10';
        return 'border-gray-500 bg-gray-500/10';
    }

    function getRatingDot(rating: string): string {
        if (rating.includes('Safe')) return 'bg-green-400';
        if (rating.includes('Suggestive')) return 'bg-cyan-400';
        if (rating.includes('Questionable')) return 'bg-amber-400';
        if (rating.includes('Explicit')) return 'bg-red-400';
        return 'bg-gray-400';
    }

    /** Maps context-id -> current name, read live from the page (for Import/share-link flows). */
    function buildContextIdNameMap(): Map<string, string> {
        const map = new Map<string, string>();
        document.querySelectorAll<HTMLElement>('[data-schedule-btn][data-context-id]').forEach(btn => {
            const contextId = btn.dataset.contextId;
            if (contextId && !map.has(contextId)) {
                map.set(contextId, btn.dataset.name || contextId);
            }
        });
        return map;
    }

    function syncScheduleButtonById(id: string, added: boolean) {
        document.querySelectorAll<HTMLElement>('[data-schedule-btn]').forEach(btn => {
            const btnId = makeEventId(btn.dataset.contextId, btn.dataset.name || '');
            if (btnId !== id) return;

            if (added)
            {
                // Achievement: add something to My Schedule
                if (!window.steamAchievements.isUnlocked('schedule')) {
                    window.steamAchievements.unlock('schedule');
                }
                btn.textContent = 'Added to My Schedule';
            }
            else
            {
                btn.textContent = '+ Add to My Schedule';
            }

            btn.classList.toggle('schedule-btn-added', added);
            btn.classList.toggle('schedule-btn-default', !added);
        });
    }

    function syncAllScheduleButtons() {
        document.querySelectorAll<HTMLElement>('[data-schedule-btn]').forEach(btn => {
            const id = makeEventId(btn.dataset.contextId, btn.dataset.name || '');
            const saved = isIdSaved(id);

            if (saved)
            {
                // Achievement: add something to My Schedule // Added when you refresh the page to count existing achievement
                if (!window.steamAchievements.isUnlocked('schedule')) {
                    window.steamAchievements.unlock('schedule');
                }
                btn.textContent = 'Added to My Schedule';
            }
            else
            {
                btn.textContent = '+ Add to My Schedule';
            }

            btn.classList.toggle('schedule-btn-added', saved);
            btn.classList.toggle('schedule-btn-default', !saved);
        });
    }

    function parseSharedContextIds(raw: string): string[] {
        let value = raw.trim();

        try {
            const url = new URL(value, window.location.href);
            value = url.searchParams.get(SHARE_PARAM) || value;
        } catch {
            // Plain pasted text is okay here.
        }

        value = value.replace(/^#?schedule=/i, '');

        return [...new Set(
            value
                .split(/[\s,]+/)
                .map(id => id.trim())
                .filter(Boolean)
        )];
    }

    function importContextIds(contextIds: string[]) {
        const nameById = buildContextIdNameMap();

        const found = contextIds.filter(id => nameById.has(id));
        const missing = contextIds.filter(id => !nameById.has(id));

        replaceWithContextIds(found, nameById);
        renderMySchedule();
        updateScheduleBadge();
        syncAllScheduleButtons();

        return { added: found.length, missing };
    }

    async function shareMySchedule() {
        const contextIds = getSavedContextIds();
        if (contextIds.length === 0) {
            alert('Add at least one panel before sharing your schedule.');
            return;
        }

        const url = new URL(window.location.href);
        url.searchParams.set(SHARE_PARAM, contextIds.join(','));
        const shareUrl = url.toString();

        try {
            await navigator.clipboard.writeText(shareUrl);
            alert('Share link copied to your clipboard.');
        } catch {
            prompt('Share this link:', shareUrl);
        }
    }

    function promptImportSchedule() {
        const pasted = prompt('Paste a shared schedule link or context-id list:');
        if (!pasted) return;

        const contextIds = parseSharedContextIds(pasted);
        if (contextIds.length === 0) {
            alert('No context IDs found.');
            return;
        }

        const { added, missing } = importContextIds(contextIds);
        const missingText = missing.length ? ` ${missing.length} could not be found on this schedule page.` : '';
        alert(`Imported ${added} panel${added === 1 ? '' : 's'}.${missingText}`);
    }

    function importScheduleFromUrl() {
        if (handledUrlImport) return;
        handledUrlImport = true;

        const url = new URL(window.location.href);
        const raw = url.searchParams.get(SHARE_PARAM);
        if (!raw) return;

        const contextIds = parseSharedContextIds(raw);
        if (contextIds.length === 0) return;
        if (!confirm(`Replace your My Schedule with ${contextIds.length} shared panel${contextIds.length === 1 ? '' : 's'}?`)) return;

        const { added, missing } = importContextIds(contextIds);
        url.searchParams.delete(SHARE_PARAM);
        window.history.replaceState({}, '', url.toString());

        const missingText = missing.length ? ` ${missing.length} could not be found on this schedule page.` : '';
        alert(`Imported ${added} panel${added === 1 ? '' : 's'}.${missingText}`);
    }

    // -- Drawer open/close ---------------------------------------------------------

    function openDrawer() {
        const drawer = document.getElementById('my-schedule-drawer')!;
        const panel  = document.getElementById('my-schedule-panel')!;
        const backdrop = document.getElementById('my-schedule-backdrop')!;
        drawer.classList.remove('pointer-events-none');
        backdrop.classList.replace('opacity-0', 'opacity-100');
        backdrop.classList.add('pointer-events-auto');
        panel.classList.replace('translate-x-full', 'translate-x-0');
        renderMySchedule();
    }

    function closeDrawer() {
        const drawer = document.getElementById('my-schedule-drawer')!;
        const panel  = document.getElementById('my-schedule-panel')!;
        const backdrop = document.getElementById('my-schedule-backdrop')!;
        drawer.classList.add('pointer-events-none');
        backdrop.classList.replace('opacity-100', 'opacity-0');
        backdrop.classList.remove('pointer-events-auto');
        panel.classList.replace('translate-x-0', 'translate-x-full');
    }

    // -- Badge ---------------------------------------------------------------------

    function updateScheduleBadge() {
        const count = getSavedRefs().length;
        const badge = document.getElementById('my-schedule-badge');
        if (!badge) return;
        badge.textContent = String(count);
        badge.classList.toggle('hidden', count === 0);
    }

    // -- Render --------------------------------------------------------------------

    let currentDayFilter = 'All';

    function timeStringToSortValue(timeStr: string): number {
        const match = timeStr.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
        if (!match) return 0;
        let [, hourStr, minuteStr, ampm] = match;
        let hour = parseInt(hourStr, 10) % 12;
        if (ampm.toUpperCase() === 'PM') hour += 12;
        if (hour < 8) hour += 24; // post-midnight -> end of the schedule day
        return hour * 60 + parseInt(minuteStr, 10);
    }

    function renderMySchedule() {
        const list    = document.getElementById('my-schedule-list')!;
        const empty   = document.getElementById('my-schedule-empty')!;
        const countEl = document.getElementById('my-schedule-count')!;

        // Always resolve against the live page data — never trust
        // whatever time/room/day was stored previously.
        const index = buildLiveScheduleIndex();
        const all = resolveSavedSchedule(index).sort((a, b) => {
            if (!!a.stale !== !!b.stale) return a.stale ? 1 : -1;
            return timeStringToSortValue(a.startTime) - timeStringToSortValue(b.startTime);
        });

        countEl.textContent = `${all.length} event${all.length !== 1 ? 's' : ''} saved`;

        const filtered = currentDayFilter === 'All'
            ? all
            : all.filter(e => e.day === currentDayFilter);

        if (filtered.length === 0) {
            list.classList.add('hidden');
            empty.classList.remove('hidden');
            empty.classList.add('flex');
        } else {
            list.classList.remove('hidden');
            empty.classList.add('hidden');
            empty.classList.remove('flex');
        }

        const byDay: Record<string, SavedEvent[]> = {};
        filtered.forEach(e => { (byDay[e.day] ??= []).push(e); });

        const dayOrder = ['Friday', 'Saturday', 'Sunday', 'Unknown'];
        const dayHeaderLabel: Record<string, string> = { Unknown: 'No Longer Listed' };
        const days = currentDayFilter === 'All'
            ? dayOrder.filter(d => byDay[d])
            : [currentDayFilter].filter(d => byDay[d]);

        list.innerHTML = days.map(day => `
            <div class="mb-4">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">${dayHeaderLabel[day] || day}</h3>
                <div class="space-y-2">
                    ${byDay[day].map(event => `
                        <div class="relative group border-l-4 ${event.stale ? 'border-gray-600 bg-gray-800/60' : getRatingBorder(event.rating)} bg-gray-800 p-3 transition-all hover:brightness-110">
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-white text-sm leading-tight">${event.name}</p>
                                    ${event.business_name ? `<p class="text-gray-400 text-xs mt-0.5">${event.business_name}</p>` : ''}
                                    ${event.stale ? `
                                        <p class="text-amber-400 text-xs mt-1.5">No longer on the schedule — it may have moved or been cancelled.</p>
                                    ` : `
                                        <div class="flex items-center gap-2 mt-1.5 text-xs text-gray-400 flex-wrap">
                                            <span>${event.startTime} - ${event.endTime}</span>
                                            <span class="text-gray-600">•</span>
                                            <span>${event.room}</span>
                                        </div>
                                    `}
                                </div>
                                <button
                                    class="remove-event-btn shrink-0 text-gray-600 hover:text-red-400 p-1 rounded opacity-0 group-hover:opacity-100 cursor-pointer"
                                    data-id="${event.id.replace(/"/g, '&quot;')}"
                                    title="Remove from My Schedule"
                                >
                                    X
                                </button>
                            </div>
                            ${event.stale ? '' : `
                                <div class="flex items-center gap-1.5 mt-2">
                                    <span class="w-2 h-2 rounded-full ${getRatingDot(event.rating)} shrink-0"></span>
                                    <span class="text-xs text-gray-500">${event.rating || 'Unrated'}</span>
                                </div>
                            `}
                        </div>
                    `).join('')}
                </div>
            </div>
        `).join('');

        // Attach remove buttons
        list.querySelectorAll<HTMLElement>('.remove-event-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id!;
                removeSavedId(id);
                renderMySchedule();
                syncScheduleButtonById(id, false);
                updateScheduleBadge();
            });
        });
    }

    // -- Init ----------------------------------------------------------------------

    function toggleDrawer() {
        const panel = document.getElementById('my-schedule-panel');
        if (!panel) return;
        const isClosed = panel.classList.contains('translate-x-full');
        if (isClosed) {
            openDrawer();
        } else {
            closeDrawer();
        }
    }

    function init() {
        document.getElementById('open-my-schedule-btn')
            ?.addEventListener('click', openDrawer);
        document.getElementById('toggle-schedule-btn')
            ?.addEventListener('click', toggleDrawer);
        document.getElementById('close-my-schedule-btn')
            ?.addEventListener('click', closeDrawer);
        document.getElementById('my-schedule-backdrop')
            ?.addEventListener('click', closeDrawer);
        document.getElementById('share-my-schedule-btn')
            ?.addEventListener('click', shareMySchedule);
        document.getElementById('import-my-schedule-btn')
            ?.addEventListener('click', promptImportSchedule);

        document.getElementById('clear-my-schedule-btn')
            ?.addEventListener('click', () => {
                if (!confirm('Remove all saved events?')) return;
                saveSavedRefs([]);
                renderMySchedule();
                updateScheduleBadge();
                syncAllScheduleButtons();
            });

        // Day filter tabs
        const tabs = document.querySelectorAll<HTMLElement>('.my-schedule-day-tab');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                currentDayFilter = tab.dataset.day!;
                tabs.forEach(t => {
                    t.classList.remove('text-white', 'border-amber-400');
                    t.classList.add('text-gray-400', 'border-transparent');
                });
                tab.classList.add('text-white', 'border-amber-400');
                tab.classList.remove('text-gray-400', 'border-transparent');
                renderMySchedule();
            });
        });
        // Activate "All" tab by default
        tabs[0]?.classList.add('text-white', 'border-amber-400');
        tabs[0]?.classList.remove('text-gray-400', 'border-transparent');

        // Listen for events dispatched by ScheduleModal buttons
        document.addEventListener('toggle-my-schedule-event', (e: Event) => {
            const { id, added } = (e as CustomEvent).detail;
            syncScheduleButtonById(id, added);
            updateScheduleBadge();
            // Re-render if drawer is open
            const panel = document.getElementById('my-schedule-panel');
            if (panel && !panel.classList.contains('translate-x-full')) {
                renderMySchedule();
            }
        });

        // Sync all add-buttons on page load to reflect current localStorage
        syncAllScheduleButtons();

        updateScheduleBadge();
        importScheduleFromUrl();
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);
</script>

<style is:global>
    .schedule-btn-default {
        background-color: rgb(217 119 6);
        color: white;
    }
    .schedule-btn-default:hover {
        background-color: rgb(180 83 9);
    }
    .schedule-btn-added {
        background-color: rgb(22 163 74);
        color: white;
    }
    .schedule-btn-added:hover {
        background-color: rgb(21 128 61);
    }
</style>