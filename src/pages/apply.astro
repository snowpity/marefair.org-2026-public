---
import { Image, getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import BgTileable from '@components/BgTileable.astro';

import header from '@assets/apply/header_tileable.png';
import mare from '@assets/apply/mare.png';
import banner from '@assets/apply/banner.png';
import bannermobile from '@assets/apply/bannermobile.png';

import COA from '@assets/apply/COA_Lineup.png';
const COAWidth = 300;
const COACount = 4;
const atlas = await getImage({ src: COA, format: "avif", height: COAWidth });

const links = [
    {
        link: "https://reg.marefair.org/apply/application.php?c=musician",
        name: "Musician"
    },
    {
        link: "https://reg.marefair.org/apply/application.php?c=vendor",
        name: "Vendor"
    },
    {
        link: "https://reg.marefair.org/staff/application.php",
        name: "Staff"
    },
    {
        link: "https://reg.marefair.org/apply/application.php?c=panel",
        name: "Panelist"
    },
]

const headerTile = await getImage({ src: header, format:"avif", height:600});

import pillar_top from "@assets/apply/pillar_top.png";
import pillar_tile_src from "@assets/apply/pillar_tile.png";
const pillar_tile = await getImage({ src: pillar_tile_src, format:"avif", width:1000});
import pillar_bottom from "@assets/apply/pillar_bottom.png";

import woodRaw from "@assets/bg/wood.png";
const wood = await getImage({ src: woodRaw, format:"png", height:2048});
---

<Layout title="Apply | Mare Fair 2026">
    <BgTileable imgSrc={wood.src} vignette stain/>

    <div class="sm:block hidden">
        <div inert>
            <div class="absolute min-w-[1000px] h-full z-10" style={`background-image: url(${pillar_tile.src});`}/>
            <Image src={pillar_top} width={1000} format="avif" alt="" class="absolute top-0 left-0 min-w-[1000px] pt-[90px] z-10"/>
            <Image src={pillar_bottom} width={1000} format="avif" alt="" class="absolute bottom-0 left-0 min-w-[1000px] pt-[90px] z-10"/>
        </div>

        <!-- Right side pillars (mirrored) -->
        <div inert>
            <div class="absolute min-w-[1000px] h-full right-0 scale-x-[-1] z-10" style={`background-image: url(${pillar_tile.src});`}/>
            <Image src={pillar_top} width={1000} format="avif" alt="" class="absolute top-0 right-0 min-w-[1000px] pt-[90px] scale-x-[-1] z-10"/>
            <Image src={pillar_bottom} width={1000} format="avif" alt="" class="absolute bottom-0 right-0 min-w-[1000px] pt-[90px] scale-x-[-1] z-10"/>
        </div>
    </div>

    <div class="pointer-events-none absolute top-0 bg-repeat-x h-[350px] w-full z-10" style={`background-image: url(${headerTile.src});`}/>

    <div class="group">
        <input type="checkbox" id="checkbox_modal" class="peer hidden" autocomplete="off">
        <div class="peer-checked:pointer-events-auto pointer-events-none peer-checked:opacity-100 opacity-0 pointer-events-none bg-black/70 fixed w-screen h-screen z-50 transition-opacity flex justify-center items-center">
            <label id="vendorModal" for="checkbox_modal" tabindex="0" role="button" aria-label="Modal Switch" class="cursor-pointer absolute top-0 w-full h-full"/>
            <div class="group-has-[:checked]:pointer-events-auto relative pointer-events-none w-fit h-fit flex flex-col p-10 germania-one-regular gap-3 items-center rounded-2xl overflow-hidden shadow-[0_0_35px_rgba(0,0,0,1)] bg-[#4d5260]">
                <h1 class="relative text-center text-4xl text-amber-200"> We are recruiting from different kinds of vendors!</h1>
                <a href="https://reg.marefair.org/apply/application.php?c=vendor" target="_blank"   class="relative vendor-button"> Vendor </a>
                <a href="https://reg.marefair.org/apply/application.php?c=advendor" target="_blank" class="relative vendor-button"> Afterdark Vendor </a>
                <a href="https://reg.marefair.org/apply/application.php?c=artist" target="_blank"   class="relative vendor-button"> Artist Alley </a>
            </div>
        </div>
    </div>

    <div class="flex justify-center mx-auto sm:w-1/3 w-auto">
        <div id="mobile-view" class="z-10 z-10 flex flex-col justify-between min-h-screen">
            <div class="relative sm:hidden block z-10">
                <Image src={bannermobile} width={640} alt="Apply"/>
                <div class="absolute top-[3%] left-[2%] w-full grid grid-cols-1 gap-[2%] p-[15%] pl-[12%]">
                    {
                        links.map((link, index) => (
                            <>
                            {link.name == "Vendor" ? ( /* vendor will be served a modal instead*/
                                    <label for="checkbox_modal" tabindex="0" role="button" aria-label="Vendor Modal" class="transition-all cursor-pointer hover:scale-105 hover:drop-shadow-[0_0_10px_rgba(255,0,0,1)]">
                                        <div class="aspect-square w-full h-auto bg-repeat-x bg-size-[400%_auto]" style={`background-image: url(${atlas.src}); background-position: -${index * 100}%;`}></div>
                                    </label>
                                ) : (
                                    <a href={link.link} target="_blank" class="transition-all cursor-pointer hover:scale-105 hover:drop-shadow-[0_0_10px_rgba(255,0,0,1)]">
                                        <div class="aspect-square w-full h-auto bg-repeat-x bg-size-[400%_auto]" style={`background-image: url(${atlas.src}); background-position: -${index * 100}%;`}></div>
                                    </a>
                                )
                            }
                            </>
                        ))

                    }
                </div>
            </div>

            <!-- Banner section -->
            <div class="relative sm:block hidden translate-x-1/2 z-10" style={`--atlas-count: ${COACount};`}>
                <Image src={banner} width={1400} format="avif" alt="Apply" class="h-full aspect-[700/790]" inert/>
                <div class="absolute bottom-[8%] left-0 w-full grid grid-cols-2 gap-[2%] p-[15%] pl-[12%]">
                    {
                        links.map((link, index) => (
                            <>
                            {link.name == "Vendor" ? ( /* vendor will be served a modal instead*/
                                    <label for="checkbox_modal" tabindex="0" role="button" aria-label="Modal Switch" class="transition-all cursor-pointer hover:scale-105 hover:drop-shadow-[0_0_10px_rgba(255,0,0,1)]">
                                        <div class="atlas h-auto bg-repeat-x" style={`background-image: url(${atlas.src}); background-position: -${index * 100}%;`}></div>
                                    </label>
                                ) : (
                                    <a href={link.link} target="_blank" aria-label={link.name} class="transition-all cursor-pointer hover:scale-105 hover:drop-shadow-[0_0_10px_rgba(255,0,0,1)]">
                                        <div class="atlas h-auto bg-repeat-x" style={`background-image: url(${atlas.src}); background-position: -${index * 100}%;`}></div>
                                    </a>
                                )
                            }

                            </>
                        ))
                    }
                </div>
            </div>

            <Image src={mare} width={1400} format="avif" alt="" class="sm:-translate-x-1/2 translate-x-0 sm:-mt-64 mt-0 z-1"/>
        </div>

    </div>
</Layout>

<style>
    @reference "tailwindcss";
    .center-horizontally{
        @apply left-1/2 -translate-x-1/2;
    }
    .atlas {
        @apply aspect-square w-full;
        background-size: calc(var(--atlas-count) * 100%);
    }

    .content-wrapper {
        position: absolute;
        inset: 0;
    }

    .vendor-button {
        @apply text-center text-xl min-w-0 w-40 h-15 bg-orange-100  flex items-center justify-center rounded-xl hover:scale-105 hover:shadow-[5px_5px_0_rgba(0,0,0,1)] transition-all;
    }

    .velvet-color {
        filter: sepia(100%) hue-rotate(180deg) saturate(50%);
    }
</style>