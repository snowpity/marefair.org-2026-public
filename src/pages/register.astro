---
import { Image, getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import BgTileable from '@components/BgTileable.astro';
import { marked } from 'marked';
import Prose from '@components/ProseRegister.astro';

import woodRaw from "@assets/bg/wood.png";
const wood = await getImage({ src: woodRaw, format:"png", height:2048});

import Potion_zeeb from "@assets/register/Potion_zeeb.png";

import { badges } from "@components/BadgeData.ts";

function parseMarkdown(text: string) {
    const html = marked.parseInline(text);
    return html;
}

import atlasRaw from '@assets/register/atlas.png';
const atlasHeight = 600;
const atlasCount = 15;
const atlas = await getImage({ src: atlasRaw, format: "avif", height: atlasHeight });
---

<Layout title="Register | Mare Fair 2026">
    <BgTileable imgSrc={wood.src} vignette stain/>
    <div id="potionWrapper" class="lg:w-3/5 w-[96%] h-[92svh] overflow-hidden overflow-y-scroll bg-black/50 rounded-xl m-[2%] p-[2%] lora-500 text-white flex flex-col gap-6"
        style={`--atlas-count: ${atlasCount};`}>

        <h1 class="text-center text-8xl"> BADGES </h1>
        {/*
        <center>
            <p> Badge registration will open on February 07, 2026 </p>
            <p class="mb-10" id="countDownElement">  </p>
        </center>
        */}

    {badges.map((badge, index) => (
        <>
        {index == 11 ? (
            <h1 class="badge-header mt-20"> SPIRIT </h1>
        ) : (
            ""
        )}
        <Prose>
        <div class="flex sm:flex-row flex-col">
            <div class="atlas" id={`potion-${index}`} style={`background-image: url(${atlas.src}); background-position: -${index * 100}%;`}></div>
            <div class="w-full sm:pl-[2.5%] sm:pr-0 px-[10%]">
                <h2> {badge.title} </h2>
                <p class="text-neutral-400"> Price: {badge.price} </p>
                <p class="text-neutral-400 mb-5"> {badge.notes} </p>
                <ul class="list-disc list-inside">
                {badge.perks.map((perk, index) => (
                    <li set:html={parseMarkdown(perk)} />
                ))}
                </ul>
            </div>
        </div>
        </Prose>
        {badge.soldOut ? (
            <div class="purchase-button sold-out"> Sold Out </div>
        ) : (
            <a href={badge.link} class="purchase-button"> Purchase </a>
        )}
        {(index !== badges.length - 1) && (index !== 10) ? <hr/> : ""}
        </>
    ))}
    </div>

    <div id="Chatbox" class="absolute top-0 right-0 w-1/3 h-[92%] m-[2%] p-[2%] bg-black/50 rounded-xl lg:block hidden peer">
        {/* Inject these dynamically only for js users */}
    </div>

    <Image id="PotionSeller" src={Potion_zeeb} width="1024" alt="The Potion Seller" class="w-3/5 -mb-[20%] -mr-[20%] self-start absolute bottom-0 right-0 p-10 pb-0 lg:block hidden peer-hover:opacity-10 peer-focus-within:opacity-10 transition-opacity" inert/>
</Layout>

<style>
    @reference "tailwindcss";
    hr {
        @apply border-0 block min-h-[1px] bg-[linear-gradient(to_right,transparent_0%,white_20%,white_80%,transparent_100%)];
    }
    .center-horizontally {
        @apply left-1/2 -translate-x-1/2;
    }
    .purchase-button {
        @apply sm:min-w-24 min-w-full min-h-12 bg-green-800 hover:bg-green-950 transition-colors ml-auto rounded-lg flex items-center justify-center;
    }
    .sold-out {
        @apply pointer-events-none bg-neutral-800;
    }
    .badge-header {
        @apply text-center text-8xl mb-10;
    }

    @property --t {
        syntax: '<number>';
        inherits: false;
        initial-value: 0;
    }

    .atlas {
        @apply aspect-square sm:w-[300px] w-full h-auto bg-repeat-x;
        background-size: calc(var(--atlas-count) * 100%);
        animation: organic-wave 10s linear infinite paused;
        translate: calc(sin(var(--t) * 3) * 2px) calc(sin(var(--t) * 2) * 5px);
        rotate: calc(sin(var(--t) * 4) * 2deg);
        transition: filter 0.3s, translate 0.3s ease-out, rotate 0.3s ease-out;
    }

    .atlas:hover {
        animation-play-state: running;
        animation: organic-wave 10s linear infinite, glow-pulse 2s ease-in-out infinite;
    }

    @keyframes organic-wave {
        to { --t: 6.28318; } /* 2pi */
    }

    @keyframes glow-pulse {
        0%, 100% {
            filter: drop-shadow(0 0 0 transparent);
        }
        50% {
            filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.5));
        }
    }
</style>

<style is:global>
    @reference "tailwindcss";
    .potion-seller-chat  {
        @apply text-red-500
    }
    .user-chat  {
        @apply text-green-500
    }
</style>

<script>
