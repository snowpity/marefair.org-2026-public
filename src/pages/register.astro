                    "Why thank you, dear traveler! Though I'm just a simple potion seller, I appreciate the kind words. Now, about those badges...",
                    "How kind of you to say, wanderer! Flattery won't get you stronger potions, but I'm happy to help with convention questions.",
                    "You're too kind, traveler! I'm flattered, though my focus remains on helping you with Mare Fair information. What would you like to know?",
                    "Thank you, wanderer! That's very sweet. Now, shall we return to matters of badges and the convention? I'm here to help guide you."
                ],
                farewell: [
                    "Farewell, traveler! May your journey to Mare Fair be smooth, and may you find the perfect badge tier for your needs. Safe travels!",
                    "Goodbye, wanderer! I hope I've been helpful. Enjoy Mare Fair, and remember: early registration saves you gold!",
                    "Until we meet again, traveler! Best of luck with your registration, and I hope to see you at the convention!",
                    "Farewell, dear wanderer! May your Mare Fair experience be magical. Don't forget to register early for the best prices!"
                ],
                court: [
                    "How forward! Hoverver, such topics are not appropriate for discussion here, traveler. Let us focus on matters of badges and the convention.",
                    "I'm afraid I cannot assist with your love quest, wanderer. My expertise lies in potions and Mare Fair information.",
                    "I'm glad you're allured by my charm, but that is not a topic I can engage with, traveler. Let's return to discussing badges and events at Mare Fair.",
                    "I'm here to help with Mare Fair questions, wanderer, but that subject is beyond my purview. Shall we continue discussing the convention?"
                ]
            };

            function getResponse(state: ConversationState, message: string): string {
                // Indexed response
                // Handle potion seller copypasta
                if (state === 'potion_request') {
                    const response = potionResponses[potionIndex];
                    potionIndex = (potionIndex + 1) % potionResponses.length;
                    return response;
                }

                if (state === 'quit_response') {
                    const response = quitResponses[quitIndex];
                    quitIndex = (quitIndex + 1) % quitResponses.length;
                    return response;
                }
                if (state === 'respect') {
                    return respectResponse;
                }

                const stateResponses = responses[state] || responses.idle;

                // Add contextual variations based on conversation history
                if (context.conversationDepth > 3 && Math.random() > 0.7) {
                    // Occasionally reference previous topics
                    const discussedTopics = Array.from(context.topicsDiscussed);
                    if (discussedTopics.length > 0 && Math.random() > 0.5) {
                        const topic = discussedTopics[Math.random() * discussedTopics.length | 0];
                        return `As I mentioned about ${topic}, ${stateResponses[Math.random() * stateResponses.length | 0].toLowerCase()}`;
                    }
                }

                // Check for specific badge tier mentions
                if (context.badgeTierMentioned && state === 'badge_tiers') {
                    const tier = context.badgeTierMentioned.toLowerCase();
                    if (tier.includes('schizo')) {
                        return "Mare Schizo, the ultimate tier at $15,555! It includes executive suite, backstage pass, dinner with organizers, theme park tickets, and badges for friends. Truly the most exclusive experience, traveler.";
                    } else if (tier.includes('fanatic')) {
                        return "Mare Fanatic at $5,555 includes VIP suite, limo service, restaurant gift card worth $405, and tickets for friends to events. A substantial commitment, wanderer!";
                    } else if (tier.includes('aficionado')) {
                        return "Mare Aficionado, $2,700, includes VIP suite, custom badge art, shaded art commission, messenger bag, and Charter Day Cruise tickets. Quite the premium experience!";
                    }
                }

                return stateResponses[Math.random() * stateResponses.length | 0];
            }

            function updateContext(intent: Intent | null, message: string) {
                context.conversationDepth++;
                context.history.push(message);
                if (context.history.length > 10) {
                    context.history.shift(); // Keep last 10 messages
                }

                if (intent?.state) {
                    context.state = intent.state;
                    context.topicsDiscussed.add(intent.name);
                }

                // Track badge tier mentions
                const badgeTierKeywords = ['fairgoer', 'supporter', 'enjoyer', 'enthusiast', 'admirer', 'connoisseur', 'aficionado', 'fanatic', 'schizo', 'latecoomer'];
                for (const tier of badgeTierKeywords) {
                    if (message.toLowerCase().includes(tier)) {
                        context.badgeTierMentioned = tier;
                        break;
                    }
                }

                // Track mare mentions
                if (message.toLowerCase().includes('mare') || message.toLowerCase().includes('pony')) {
                    context.userMentionedMare = true;
                }

                context.lastIntent = intent?.name || null;
            }

            // ============ UI SETUP ============

            const messagesDiv = document.createElement("div");
            messagesDiv.className = "flex flex-col gap-2 mb-4 overflow-y-auto max-h-[90%]";
            messagesDiv.innerHTML = `
                <div class="whitespace-normal">
                    <p class="potion-seller-chat inline">Potion Seller: </p>
                    <p class="inline text-white">${responses.greeting[0]}</p>
                </div>
            `;

            const typingIndicator = document.createElement("div");
            typingIndicator.id = "ChatDelayIndicator";
            typingIndicator.className = "w-fit text-white bg-neutral-900 rounded-xl text-sm p-2 hidden";
            typingIndicator.textContent = "Typing...";

            const inputContainer = document.createElement("div");
            inputContainer.className = "mt-auto";
            inputContainer.innerHTML = `
                <input
                    type="text"
                    id="userInput"
                    placeholder="Type your message..."
                    class="w-full p-2 mb-2 rounded bg-black/70 text-white border border-gray-600 focus:outline-none focus:border-gray-400"
                />
            `;

            chatbox.innerHTML = "";
            chatbox.appendChild(inputContainer);
            chatbox.appendChild(messagesDiv);
            chatbox.appendChild(typingIndicator);

            const input = document.getElementById("userInput") as HTMLInputElement;

            function addMessage(sender: string, text: string, isUser = false) {
                const messageDiv = document.createElement("div");
                messageDiv.className = isUser ? "whitespace-normal text-right" : "whitespace-normal";
                messageDiv.innerHTML = `
                    <p class="${isUser ? 'user-chat' : 'potion-seller-chat'} inline">${sender}: </p>
                    <p class="inline text-white">${text}</p>
                `;
                messagesDiv.appendChild(messageDiv);
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }

            // ============ MESSAGE HANDLING ============

            input.addEventListener("keypress", (e) => {
                if (e.key === "Enter" && input.value.trim()) {
                    const userMessage = input.value.trim();
                    addMessage("User", userMessage, true);

                    const { intent, confidence } = detectIntent(userMessage);

                    // Update context based on detected intent
                    updateContext(intent || null, userMessage);

                    // Determine response state
                    let responseState: ConversationState = context.state;

                    // Handle special cases
                    if (intent?.name === 'who_are_you') {
                        responseState = 'small_talk';
                    } else if (intent?.name === 'mare_mention' && !context.userMentionedMare) {
                        responseState = 'theme';
                    } else if (intent?.state) {
                        responseState = intent.state;
                    } else if (confidence < 3) {
                        // Low confidence, try to maintain context or go to idle
                        if (context.state !== 'greeting') {
                            responseState = 'idle';
                        }
                    }

                    const response = getResponse(responseState, userMessage);

                    // Calculate typing delay (more natural variation)
                    const baseDelay = response.length * 15;
                    const variation = Math.random() * 500 + 200; // 200-700ms variation
                    const delayTime = baseDelay + variation;

                    typingIndicator.classList.remove("hidden");

                    setTimeout(() => {
                        addMessage("Potion Seller", response);
                        typingIndicator.classList.add("hidden");

                        // Auto-transition to idle after response (unless in farewell)
                        if (responseState !== 'farewell' && responseState !== 'greeting') {
                            setTimeout(() => {
                                if (Math.random() > 0.7) { // 30% chance to prompt
                                    const idlePrompt = responses.idle[Math.random() * responses.idle.length | 0];
                                    setTimeout(() => {
                                        typingIndicator.classList.remove("hidden");
                                        setTimeout(() => {
                                            addMessage("Potion Seller", idlePrompt);
                                            typingIndicator.classList.add("hidden");
                                        }, idlePrompt.length * 15);
                                    }, 1000);
                                }
                            }, 2000);
                        }
                    }, delayTime);

                    input.value = "";
                }
            });
        }
    });
</script>

<script>
    interface CountdownTimer {
        interval: number | null;
        stop(): void;
        start(): void;
    }

    class BrowserCountdownTimer implements CountdownTimer {
        private targetDate: Date;
        private countDownElement: HTMLElement;
        private timeZone: string;
        interval: number | null = null;

        constructor(targetDate: string, elementId: string, timeZone: string = 'UTC') {
            // Ensure the input date is interpreted in the specified timezone
            this.timeZone = timeZone;

            // Create a formatter for the target timezone
            const formatter = new Intl.DateTimeFormat('en-US', {
                timeZone: this.timeZone,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            });

            this.targetDate = new Date(targetDate);
            const element = document.getElementById(elementId);
            if (!element) {
                throw new Error(`Element with id ${elementId} not found`);
            }
            this.countDownElement = element;
        }

        private formatTimeComponent(value: number): string {
            return value.toString().padStart(2, '0');
        }

        private updateCountdown(): void {
            const now = new Date();

            // Convert current time to target timezone
            const targetNow = new Date(now.toLocaleString('en-US', { timeZone: this.timeZone }));
            const timeDiff: number = this.targetDate.getTime() - targetNow.getTime();

            if (timeDiff <= 0) {
                if (this.countDownElement) {
                    this.countDownElement.textContent = "Time is up!";
                }
                this.stop();
                return;
            }

            const days: number = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
            const hours: number = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes: number = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds: number = Math.floor((timeDiff % (1000 * 60)) / 1000);

            if (this.countDownElement) {
                const timeZoneAbbr = new Intl.DateTimeFormat('en-US', {
                    timeZone: this.timeZone,
                    timeZoneName: 'short'
                }).formatToParts(this.targetDate)
                    .find(part => part.type === 'timeZoneName')?.value || this.timeZone;

                this.countDownElement.textContent =
                    `That's ${days} days, ${this.formatTimeComponent(hours)} hours, ` +
                    `${this.formatTimeComponent(minutes)} minutes, ${this.formatTimeComponent(seconds)} seconds ` +
                    `from now (${timeZoneAbbr})`;
            }
        }

        start(): void {
            if (this.interval === null) {
                this.updateCountdown(); // Initial update
                this.interval = window.setInterval(() => this.updateCountdown(), 1000);
            }
        }

        stop(): void {
            if (this.interval !== null) {
                window.clearInterval(this.interval);
                this.interval = null;
            }
        }
    }

    // Time zone string is based on IANA timezone database names. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

    // For EST (East Coast Time)
    // Note: the element in the markup uses id="countDownElement", so ensure we target that.
    document.addEventListener("astro:page-load", () => {
        try {
            const timerEST = new BrowserCountdownTimer('2026-02-07T00:00:00', 'countDownElement', 'America/New_York');
            timerEST.start();
        } catch (err) {
            // Fail gracefully and log to console for easier debugging
            console.warn('Countdown timer initialization failed:', err);
        }
    });
</script>
