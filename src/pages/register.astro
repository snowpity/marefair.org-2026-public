                            score += intent.weight;
                            // Boost score if keyword appears at start of message
                            if (lower.startsWith(keyword) || lower.includes(` ${keyword}`)) {
                                score += 2;
                            }
                        }
                    }
                    if (score > bestScore) {
                        bestScore = score;
                        bestMatch = intent;
                    }
                }

                return {
                    intent: bestMatch,
                    confidence: bestScore
                };
