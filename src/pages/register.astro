</script>

<script>
    document.addEventListener("astro:page-load", () => {

        // Some older browser **cough** current Firefox **cough** doesn't support something I need, javascript the only way to make it work properly.
        // Basically we ger rid of its animation (the t variable), then force a reflow to make sure it takes effect, then reapply it back.
        // Bottles now snaps back to origin when unhovered
        const atlases = document.querySelectorAll('.atlas') as NodeListOf<HTMLElement>;

        atlases.forEach(atlas => {
            atlas.addEventListener('mouseleave', () => {
                const currentAnimation = atlas.style.animation;
                atlas.style.animation = 'none';

                // Force a reflow to ensure the pause takes effect
                void atlas.offsetHeight;

                atlas.style.animation = currentAnimation;
            });
        });
    });
</script>

