---
import "@styles/global.css";

import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import { ACHIEVEMENTS, getIconMetadata, type AchievementId } from '@scripts/steam-achievement';

import Footer from '@components/Footer.astro';
import HamburgerMenu from '@components/HamburgerMenu.astro';
import HomeButton from '@components/HomeButton.astro';
import Banner from '@components/Banner.astro';

import type { SEO } from '@data/SEO';
import Seo from '@components/Seo.astro';

interface Props {
title?: string;
backgroundClass?: string; // Optional class for various backgrounds
seo?: SEO;
}

const { title = "Mare Fair 2026", backgroundClass = '', seo }: Props = Astro.props;

// Process all icons at build time
// This is actually a trick to link the optimized image already loaded by the overlay
// The overlay is already loaded in every page, and your browser caches it. It only needs the link generated by astro.
const processedIcons: Record<string, string> = {};
for (const id of Object.keys(ACHIEVEMENTS) as AchievementId[]) {
	const imageMeta = getIconMetadata(id);
	if (!imageMeta) continue; // emoji-icon achievements have no image to process
	const optimized = await getImage({
		src: imageMeta,
		format: 'avif',
		width: 96
	});
	processedIcons[id] = optimized.src;
}
---

<!doctype html>
<html lang="en">
<head>
	<Seo seo={seo} />
	<meta name="darkreader-lock">
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
	<ClientRouter fallback="swap"/>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Germania+One&family=Lora:ital@0;1&family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&family=Tagesschrift&display=swap" rel="stylesheet">

</head>
<body class="relative bg-black overflow-hidden min-w-screen min-h-[100lvh]">
	<HamburgerMenu/>
	<HomeButton/>
	<slot />
	<Banner />
	<Footer />
</body>
</html>

<style is:global>
	html {
		overflow-x: hidden;
		scroll-behavior: none !important;
	}

	.jsOnly {
		display: none;
	}

	.lora-500 {
		font-family: "Lora", serif;
		font-optical-sizing: auto;
		font-weight: 500;
		font-style: normal;
	}
	.germania-one-regular {
		font-family: "Germania One", system-ui;
		font-weight: 400;
		font-style: normal;
	}
	.tagesschrift-regular {
		font-family: "Tagesschrift", system-ui;
		font-weight: 400;
		font-style: normal;
	}

	.merriweather-sans-bold {
		font-family: "Merriweather Sans", sans-serif;
		font-optical-sizing: auto;
		font-weight: 600;
		font-style: normal;
	}

	/* Achievement Toast Styles */
	.achievement-toast {
		position: fixed;
		bottom: 20px;
		right: 20px;
		z-index: 999998;
		background: linear-gradient(135deg, #1e2329 0%, #171a21 100%);
		border: 1px solid #66c0f4;
		padding: 16px;
		min-width: 320px;
		max-width: 400px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
		transform: translateY(450px);
		transition: transform 0.5s ease-in-out;
	}

	.achievement-toast.show {
		transform: translateY(0);
	}

	.achievement-toast-header {
		color: #66c0f4;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 8px;
	}

	.achievement-toast-content {
		display: flex;
		gap: 12px;
		align-items: center;
	}

	.achievement-toast-icon {
		width: 48px;
		height: 48px;
		border-radius: 4px;
		background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
		flex-shrink: 0;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
	}

	.achievement-toast-text {
		flex: 1;
	}

	.achievement-toast-title {
		color: #c7d5e0;
		font-size: 14px;
		font-weight: 600;
		margin-bottom: 4px;
	}

	.achievement-toast-description {
		color: #8f98a0;
		font-size: 12px;
		line-height: 1.4;
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		// Accessibility: Make all things with Button role tab-selectable
		document.querySelectorAll('[role="button"]').forEach(label => {
			label.addEventListener('keydown', (e) => {
				const event = e as KeyboardEvent;
				if (event.key === ' ' || event.key === 'Enter') {
					e.preventDefault();
					(label as HTMLElement).click();
				}
			});
		});

		// Show JS-only elements
		document.querySelectorAll('.jsOnly').forEach(el => {
			el.classList.remove('jsOnly');
		});
	});
</script>

<script define:vars={{ processedIcons }}>
	if (!window.__processedIcons)
		window.__processedIcons = processedIcons;
</script>

<script>
	import { initializeAchievementSystem, initializeAchievementTabs } from '@scripts/steam-achievement';

	// Initialize achievement system globally (only once)
	initializeAchievementSystem();

	// Steam Overlay Emulator with session tracking
	document.addEventListener("astro:page-load", () => {
		let overlayActive = false;
		let overlayInjected = false;
		let sessionStart: Date;
		let timeUpdateInterval: number;

		// Cookie helper functions
		function setCookie(name: string, value: string, days?: number) {
			if (days !== undefined) {
				const expires = new Date();
				expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);
				document.cookie = `${name}=${value};expires=${expires.toUTCString()};path=/`;
			} else {
				document.cookie = `${name}=${value};path=/`;
			}
		}

		function getCookie(name: string): string | null {
			const nameEQ = name + "=";
			const ca = document.cookie.split(';');
			for (let i = 0; i < ca.length; i++) {
				let c = ca[i];
				while (c.charAt(0) === ' ') c = c.substring(1, c.length);
				if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
			}
			return null;
		}

		// Session management
		function getSessionStart(): Date {
			const sessionCookie = getCookie('steam_session_start');
			if (sessionCookie) {
				return new Date(parseInt(sessionCookie));
			} else {
				const now = new Date();
				setCookie('steam_session_start', now.getTime().toString());
				return now;
			}
		}

		// Format time display
		function formatSessionTime(milliseconds: number): string {
			const totalMinutes = Math.floor(milliseconds / 60000);
			const hours = Math.floor(totalMinutes / 60);
			const minutes = totalMinutes % 60;

			if (hours > 0) {
				const hourText = hours === 1 ? 'hr' : 'hrs';
				const minuteText = minutes === 1 ? 'minute' : 'minutes';
				return `${hours} ${hourText} ${minutes} ${minuteText}`;
			} else {
				const minuteText = minutes === 1 ? 'minute' : 'minutes';
				return `${minutes} ${minuteText}`;
			}
		}

		function initializeSteamTime() {
			const timeEl = document.getElementById('steam-time');
			const dateEl = document.getElementById('steam-date');
			const sessionEl = document.getElementById('steam-session-time');

			sessionStart = getSessionStart();

			function updateTime() {
				const now = new Date();

				if (timeEl) {
					let hours = now.getHours();
					const minutes = now.getMinutes().toString().padStart(2, '0');
					const ampm = hours >= 12 ? 'PM' : 'AM';
					hours = hours % 12;
					hours = hours ? hours : 12;
					timeEl.textContent = `${hours}:${minutes} ${ampm}`;
				}

				if (dateEl) {
					const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
					const months = ['January', 'February', 'March', 'April', 'May', 'June',
					               'July', 'August', 'September', 'October', 'November', 'December'];
					dateEl.textContent = `${days[now.getDay()]}. ${months[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;
				}

				if (sessionEl) {
					const sessionDuration = now.getTime() - sessionStart.getTime();
					sessionEl.textContent = formatSessionTime(sessionDuration);
				}
			}

			updateTime();
			if (timeUpdateInterval) clearInterval(timeUpdateInterval);
			timeUpdateInterval = window.setInterval(updateTime, 60000);
		}

		async function injectSteamOverlay() {
			if (overlayInjected) return;

			try {
				const response = await fetch('/steam-overlay-partial');
				if (!response.ok) {
					throw new Error(`Failed to fetch overlay: ${response.status}`);
				}

				const html = await response.text();
				const temp = document.createElement('div');
				temp.innerHTML = html;

				while (temp.firstChild) {
					document.body.appendChild(temp.firstChild);
				}

				initializeSteamTime();
				(window as any).steamAchievements?.updatePanel();
				setupOverlayListeners();

				overlayInjected = true;
				//console.log('Steam overlay injected successfully');
			} catch (error) {
				console.error('Failed to inject Steam overlay:', error);
			}
		}

		function initializeAchievementPanel() {
			const panel = document.getElementById('achievement-panel') as HTMLElement;
			const header = document.getElementById('panel-header') as HTMLElement;
			const resizeHandle = document.getElementById('resize-handle') as HTMLElement;
			const achievementsList = document.getElementById('achievements-list') as HTMLElement;

			if (!panel || !header || !resizeHandle) return;

			// Center the panel initially
			const panelRect = panel.getBoundingClientRect();
			const centerX = (window.innerWidth - panelRect.width) / 2;
			const centerY = (window.innerHeight - panelRect.height) / 2;
			panel.style.left = centerX + 'px';
			panel.style.top = centerY + 'px';

			let isDragging = false;
			let isResizing = false;
			let initialX: number, initialY: number;
			let initialWidth: number, initialHeight: number;
			let initialMouseX: number, initialMouseY: number;

			// Helper function to get client coordinates from mouse or touch event
			function getClientCoordinates(e: MouseEvent | TouchEvent): { clientX: number, clientY: number } {
				if (e instanceof TouchEvent) {
					const touch = e.touches[0] || e.changedTouches[0];
					return { clientX: touch.clientX, clientY: touch.clientY };
				}
				return { clientX: e.clientX, clientY: e.clientY };
			}

			// Unified start handler for dragging (mouse and touch)
			function startDrag(e: MouseEvent | TouchEvent) {
				if (e instanceof TouchEvent) {
					e.preventDefault(); // Prevent scrolling on touch
				}
				isDragging = true;
				const rect = panel.getBoundingClientRect();
				const coords = getClientCoordinates(e);
				initialX = coords.clientX - rect.left;
				initialY = coords.clientY - rect.top;
				header.style.cursor = 'grabbing';
			}

			// Unified start handler for resizing (mouse and touch)
			function startResize(e: MouseEvent | TouchEvent) {
				e.stopPropagation();
				if (e instanceof TouchEvent) {
					e.preventDefault(); // Prevent scrolling on touch
				}
				isResizing = true;
				const rect = panel.getBoundingClientRect();
				initialWidth = rect.width;
				initialHeight = rect.height;
				const coords = getClientCoordinates(e);
				initialMouseX = coords.clientX;
				initialMouseY = coords.clientY;
			}

			// Unified move handler (mouse and touch)
			function handleMove(e: MouseEvent | TouchEvent) {
				if (!isDragging && !isResizing) return;

				if (e instanceof TouchEvent) {
					e.preventDefault(); // Prevent scrolling while dragging/resizing
				} else {
					e.preventDefault();
				}

				const coords = getClientCoordinates(e);

				if (isDragging) {
					const x = coords.clientX - initialX;
					const y = coords.clientY - initialY;
					panel.style.left = x + 'px';
					panel.style.top = y + 'px';
					panel.style.transform = 'none';
				}

				if (isResizing) {
					const deltaX = coords.clientX - initialMouseX;
					const deltaY = coords.clientY - initialMouseY;
					const newWidth = initialWidth + deltaX;
					const newHeight = initialHeight + deltaY + 27; // For some reason I have to set an extra 27px or it will hover above the handle

					if (newWidth >= 300 && newWidth <= 800) {
						panel.style.width = newWidth + 'px';
					}

					if (newHeight >= 200 && achievementsList) {
						const newListHeight = newHeight - 200;
						achievementsList.style.maxHeight = newListHeight + 'px';
					}
				}
			}

			// Unified end handler (mouse and touch)
			function handleEnd() {
				if (isDragging) {
					isDragging = false;
					header.style.cursor = 'move';
				}
				if (isResizing) {
					isResizing = false;
				}
			}

			// Attach event listeners
			header.addEventListener('mousedown', startDrag);
			header.addEventListener('touchstart', startDrag, { passive: false });

			resizeHandle.addEventListener('mousedown', startResize);
			resizeHandle.addEventListener('touchstart', startResize, { passive: false });

			document.addEventListener('mousemove', handleMove);
			document.addEventListener('touchmove', handleMove, { passive: false });

			document.addEventListener('mouseup', handleEnd);
			document.addEventListener('touchend', handleEnd);
		}

		function setupOverlayListeners() {
			const closeBtn = document.getElementById('steam-close-btn');
			if (closeBtn) {
				closeBtn.addEventListener('click', toggleOverlay);
			}
			initializeAchievementPanel();

			initializeAchievementTabs();
		}

		function toggleOverlay() {
			const overlay = document.getElementById('steam-overlay');
			if (!overlay) return;

			overlayActive = !overlayActive;
			overlay.setAttribute('data-state', overlayActive ? 'open' : 'closed');
		}

		// Inject overlay immediately on page load
		injectSteamOverlay();

		const achievementButton = document.getElementById('Achievements') as HTMLElement;
		const hamburgerMenuButton = document.getElementById('checkbox_hamburger_menu') as HTMLInputElement;
		achievementButton.addEventListener('mouseup', () => {
			if (!overlayInjected) {
				injectSteamOverlay().then(() => {
					const overlay = document.getElementById('steam-overlay');
					if (overlay) {
						overlay.setAttribute('data-state', 'open');
						overlayActive = true;
					}
				});
			} else {
				const overlay = document.getElementById('steam-overlay');
				if (overlay) {
					overlay.setAttribute('data-state', 'open');
					overlayActive = true;
				}
			}
			if(hamburgerMenuButton) {
				hamburgerMenuButton.checked = false;
				hamburgerMenuButton.dispatchEvent(new Event('change'));
			}
		});

		// Shift+Tab listener - Remove old listeners first to prevent duplicates
		const handleKeyDown = async (e: KeyboardEvent) => {
			if (e.key === 'Shift') {
				(window as any).__shiftPressed = true;
			}

			if (e.key === 'Tab' && (window as any).__shiftPressed) {
				e.preventDefault();
				if (!overlayInjected) {
					await injectSteamOverlay();
				}
				toggleOverlay();
			}
		};

		const handleKeyUp = (e: KeyboardEvent) => {
			if (e.key === 'Shift') {
				(window as any).__shiftPressed = false;
			}
		};

		// Remove old listeners if they exist
		if ((window as any).__handleKeyDown) {
			document.removeEventListener('keydown', (window as any).__handleKeyDown);
		}
		if ((window as any).__handleKeyUp) {
			document.removeEventListener('keyup', (window as any).__handleKeyUp);
		}

		// Add new listeners
		document.addEventListener('keydown', handleKeyDown);
		document.addEventListener('keyup', handleKeyUp);

		// Store references for cleanup
		(window as any).__handleKeyDown = handleKeyDown;
		(window as any).__handleKeyUp = handleKeyUp;
	});
</script>

<script>
    import { ScrollTimelinePolyfill } from '@scripts/scroll-timeline-loader';
	ScrollTimelinePolyfill();
</script>